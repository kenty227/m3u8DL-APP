{
  "name": "m3u8-studio",
  "version": "1.2.0",
  "description": "基于 N_m3u8DL-RE 的桌面下载与定时录制工具",
  "main": "src/main.cjs",
  "desktopName": "m3u8-studio.desktop",
  "author": "m3u8 Studio",
  "license": "MIT",
  "private": true,
  "engines": { "node": ">=22.12.0" },
  "repository": { "type": "git", "url": "https://github.com/kenty227/m3u8DL-APP.git" },
  "homepage": "https://github.com/kenty227/m3u8DL-APP#readme",
  "bugs": { "url": "https://github.com/kenty227/m3u8DL-APP/issues" },
  "scripts": {
    "start": "node scripts/prepare-tools.cjs && node scripts/build-native.cjs && electron .",
    "test": "node --test tests/*.test.cjs",
    "build": "node scripts/build.cjs",
    "build:win": "node scripts/build.cjs --win --x64",
    "build:mac": "node scripts/build.cjs --mac",
    "build:linux": "node scripts/build.cjs --linux",
    "prepare:tools": "node scripts/prepare-tools.cjs",
    "share:source": "node scripts/share-source.cjs",
    "release:prepare": "node scripts/release.cjs prepare",
    "test:portable": "node scripts/portable-smoke.cjs",
    "smoke": "node scripts/smoke.cjs",
    "test:ui": "node scripts/ui-smoke.cjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.m3u8studio.desktop",
    "productName": "m3u8 Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [{ "from": ".build/bundled/${platform}-${arch}/tools", "to": "tools" }],
    "win": {
      "extraResources": [{ "from": "native/runner.exe", "to": "runner.exe" }],
      "target": [
        "portable"
      ],
      "icon": "src/renderer/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "m3u8-Studio-${version}-Windows.exe"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "binaries": ["Contents/Resources/tools/N_m3u8DL-RE", "Contents/Resources/tools/ffmpeg"],
      "icon": "src/renderer/icon-mac.png",
      "artifactName": "m3u8-Studio-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility",
      "icon": "src/renderer/icon.png",
      "maintainer": "m3u8 Studio",
      "syncDesktopName": true,
      "artifactName": "m3u8-Studio-${version}-Linux-${arch}.${ext}",
      "desktop": { "entry": { "Name": "m3u8 Studio", "Comment": "Download and schedule HLS media" } }
    }
  }
}
